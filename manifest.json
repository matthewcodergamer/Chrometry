{
  "manifest_version": 3,
  "name": "Chrometry — Game Colorimetry",
  "short_name": "Chrometry",
  "version": "1.3.0",
  "description": "Live webpage color picker and game colorimetry tools. Pick colors directly from any webpage without manually taking screenshots.",
  "action": {
    "default_title": "Chrometry — Pick a color",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "chrometry-48.png",
      "128": "chrometry-128.png"
    }
  },
  "background": {
    "service_worker": "extension-background.js"
  },
  "icons": {
    "48": "chrometry-48.png",
    "128": "chrometry-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "minimum_chrome_version": "116",
  "externally_connectable": {
    "matches": [
      "https://matthewcodergamer.github.io/Chrometry/*"
    ]
  }
}